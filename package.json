{
  "name": "thatfridge",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "app": "pnpm --filter mobile start",
    "app:ios": "pnpm --filter mobile ios",
    "app:web": "pnpm --filter mobile web",
    "legacy-web": "npm --prefix apps/web run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "turbo": "^2.5.0"
  }
}
