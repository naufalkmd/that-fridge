# Copy to .env and adjust. On a physical device use your machine's LAN IP, not 127.0.0.1.
EXPO_PUBLIC_API_URL=http://127.0.0.1:8000/api

# RevenueCat SDK key (publishable — safe to ship in the app binary).
# iOS App Store key from app.revenuecat.com → Project → API keys.
EXPO_PUBLIC_RC_IOS_KEY=

# Google Sign-In. Both from Google Cloud Console → APIs & Services → Credentials — see
# apps/mobile/RELEASE.md "Sign in with Apple / Google" for the full setup. Leaving these unset
# is fine (the button hides itself); GOOGLE_IOS_URL_SCHEME also bakes into the native build via
# app.config.ts, so it needs a rebuild to take effect, not just an OTA.
GOOGLE_IOS_URL_SCHEME=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
