{
  "cli": {
    "version": ">= 22.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "ios": { "simulator": true },
      "env": { "EXPO_PUBLIC_API_URL": "http://127.0.0.1:8000/api" }
    },
    "development-prod": {
      "extends": "development",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.thatfridge.com/api",
        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "354217060730-di8hektfrbt9imlcpqp78r63o12ao8gm.apps.googleusercontent.com",
        "EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID": "354217060730-3jpu7mbm22mknqvs55523gikkmg7nru8.apps.googleusercontent.com",
        "GOOGLE_IOS_URL_SCHEME": "com.googleusercontent.apps.354217060730-3jpu7mbm22mknqvs55523gikkmg7nru8"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "ios": { "simulator": false },
      "env": { "EXPO_PUBLIC_API_URL": "https://api.thatfridge.com/api" }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.thatfridge.com/api",
        "EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID": "354217060730-di8hektfrbt9imlcpqp78r63o12ao8gm.apps.googleusercontent.com",
        "EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID": "354217060730-3jpu7mbm22mknqvs55523gikkmg7nru8.apps.googleusercontent.com",
        "GOOGLE_IOS_URL_SCHEME": "com.googleusercontent.apps.354217060730-3jpu7mbm22mknqvs55523gikkmg7nru8"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6806239306"
      }
    }
  }
}
