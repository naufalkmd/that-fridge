# Production .env template for api.thatfridge.com — copy to `.env` on the server,
# fill every CHANGE_ME, then `php artisan key:generate`. Never commit the real .env.
# See backend/DEPLOY.md §5.

APP_NAME=ThatFridge
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.thatfridge.com          # public HTTPS URL — Storage::url() builds on this

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# --- Database (local Postgres; move to managed PG post-launch) ---
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=thatfridge
DB_USERNAME=thatfridge
DB_PASSWORD=CHANGE_ME_STRONG

# --- Redis (session + cache + queue) ---
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null

SESSION_DRIVER=redis
SESSION_LIFETIME=120
CACHE_STORE=redis
QUEUE_CONNECTION=redis

# --- File storage: receipts / fridge photos / generated icons ---
FILESYSTEM_DISK=public                       # switch to s3 post-launch (DEPLOY.md §13)

# --- Transactional mail (password resets). Pick a provider with a free tier. ---
MAIL_MAILER=smtp
MAIL_HOST=CHANGE_ME
MAIL_PORT=587
MAIL_USERNAME=CHANGE_ME
MAIL_PASSWORD=CHANGE_ME
MAIL_FROM_ADDRESS="no-reply@thatfridge.com"
MAIL_FROM_NAME=ThatFridge

# --- AI providers (same keys as local dev) ---
OPENROUTER_API_KEY=CHANGE_ME
FAL_KEY=CHANGE_ME

# --- S3 / object storage (leave blank until the post-launch migration) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
